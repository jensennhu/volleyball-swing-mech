# Volleyball Spike Platform - .gitignore

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
env/
venv/
ENV/

# pyenv
.python-version

# ============================================
# Data & Model Artifacts
# ============================================
# Video files (too large for git)
*.mp4
*.avi
*.mov
*.mkv
*.flv

# Database
*.db
*.sqlite

# Model checkpoints
checkpoints/

# Feature files
data/features/

# Uploaded videos
data/uploads/

# YOLO weights
*.pt

# ============================================
# IDEs and Editors
# ============================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ============================================
# Operating System
# ============================================
.DS_Store
._*
Thumbs.db

# ============================================
# Testing
# ============================================
.pytest_cache/
.coverage
htmlcov/

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.bak
*.log
